{
  "name": "positronic",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint",
    "test:noisy": "vitest run",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --silent --coverage",
    "test:coverage:all": "npm run test:coverage && cd packages/cloudflare/test-project && npm run test:coverage",
    "test:watch": "vitest",
    "test:all": "npm run test && cd packages/cloudflare/test-project && npm run test",
    "dev": "npm run build:workspaces && npm run test:all && npm run lint || /usr/local/bin/terminal-notifier -title \"Positronic\" -message \"Build/Test failed\"",
    "dev:watch": "nodemon --exec 'npm run dev'",
    "clean:workspaces": "npm run clean --workspaces && rm -rf node_modules",
    "build:workspaces": "npm run build --workspaces",
    "build:watch": "nodemon --exec 'npm run build:workspaces || /usr/local/bin/terminal-notifier -title \"Positronic Build\" -message \"Build failed\"'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/core/tests/tsconfig.json && (cd packages/cloudflare/test-project && npm run typecheck)",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish --no-git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@cloudflare/workers-types": "^4.20250430.0",
    "@types/node": "^20.11.17",
    "@vitest/coverage-v8": "^4.1.11",
    "nodemon": "^3.1.10",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "packages/core",
    "packages/spec",
    "packages/template-new-project",
    "packages/client-vercel",
    "packages/gen-ui-components",
    "packages/cloudflare",
    "packages/cli",
    "packages/mem0"
  ],
  "allowScripts": {
    "fsevents": true,
    "dtrace-provider": false
  }
}
