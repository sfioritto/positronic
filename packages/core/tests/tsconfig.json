{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "noUnusedLocals": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@positronic/core",
    "paths": {
      "@positronic/core/jsx-runtime": ["../src/jsx-runtime.ts"]
    }
  },
  "include": ["./**/*"]
}
