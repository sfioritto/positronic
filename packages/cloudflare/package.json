{
  "name": "@positronic/cloudflare",
  "version": "0.0.79",
  "publishConfig": {
    "access": "public"
  },
  "description": "Cloudflare bindings for Positronic brains",
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node-index.d.ts",
        "import": "./dist/node-index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf tsconfig.tsbuildinfo dist"
  },
  "dependencies": {
    "@positronic/core": "^0.0.79",
    "@positronic/spec": "^0.0.79",
    "@positronic/template-new-project": "^0.0.79",
    "aws4fetch": "^1.0.18",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.2",
    "fuse.js": "^7.1.0",
    "hono": "^4.2.3",
    "jose": "^6.2.12",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^26.4.1",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "zod": "^4.5.4"
  }
}
