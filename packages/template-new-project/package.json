{
  "name": "@positronic/template-new-project",
  "version": "0.0.79",
  "publishConfig": {
    "access": "public"
  },
  "description": "Project template and scaffolder for new Positronic projects.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf tsconfig.tsbuildinfo dist node_modules"
  },
  "license": "MIT",
  "files": [
    "dist",
    "template",
    "package.json"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "eta": "^4.6.0"
  },
  "devDependencies": {
    "oxc-parser": "^0.148.0",
    "oxc-transform": "^0.148.0"
  }
}
