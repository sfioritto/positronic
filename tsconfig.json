{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "lib": ["ESNext", "DOM", "WebWorker", "DOM.Iterable"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "exclude": [
    "packages/template-new-project/template",
    "packages/cloudflare/test-project",
    "packages/core/tests"
  ],
  "references": [
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/cli"
    },
    {
      "path": "./packages/client-vercel"
    },
    {
      "path": "./packages/cloudflare"
    },
    {
      "path": "./packages/spec"
    },
    {
      "path": "./packages/gen-ui-components"
    },
    {
      "path": "./packages/template-new-project"
    }
  ]
}
